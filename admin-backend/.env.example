PORT=3001
DB_SERVER=localhost
DB_PORT=1433
# For a named SQL Server such as SQLEXPRESS, use DB_INSTANCE and leave DB_PORT blank.
DB_INSTANCE=
DB_NAME=admin_db
DB_USER=sa
DB_PASSWORD=replace-with-your-sql-password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
AUTH_SECRET=replace-with-a-long-random-value
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
PAYMENT_REMINDER_MINUTES=240
